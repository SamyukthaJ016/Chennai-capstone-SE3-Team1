# Copy to .env and edit only what differs on your machine.
#
#   cp .env.example .env
#
# Everything here already matches the defaults baked into
# scripts/db_config.py, so a stock local PostgreSQL needs NO .env at all.
# Precedence, highest first:  CLI flag  >  environment variable  >  .env  >  default

PGHOST=localhost
PGPORT=5432
PGDATABASE=trading_platform
PGUSER=postgres
PGPASSWORD=postgres

# Only needed if psql is not on your PATH and not in the usual
# C:\Program Files\PostgreSQL\<version>\bin location.
# PSQL_BIN=C:\Program Files\PostgreSQL\17\bin\psql.exe
