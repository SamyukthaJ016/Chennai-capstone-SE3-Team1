# Copy to .env and change what you need. Defaults below match the built-in
# defaults, so a local PostgreSQL needs no .env at all.
# Precedence: CLI flag > environment variable > .env > default

PGHOST=localhost
PGPORT=5432
PGDATABASE=trading_platform
PGUSER=postgres
PGPASSWORD=postgres

# Only if psql is not on PATH and not in C:\Program Files\PostgreSQL\<version>\bin
# PSQL_BIN=C:\Program Files\PostgreSQL\17\bin\psql.exe
