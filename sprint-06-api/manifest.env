# Sprint 6 - Trading REST API
#
# Declares the base package and sub-packages for layering checks and code organization.

BASE_PACKAGE=com.team1.trading.api
CONTROLLER_PACKAGE=com.team1.trading.api.controller
MAPPER_PACKAGE=com.team1.trading.api.mapper

# The Sprint 5 domain is source in this project: it lives in this module under
# com.team1.trading.domain (entity, exception, service, dto). No artifact and no
# 'mvn install' is needed; a fresh checkout builds with one 'mvn package'.
DOMAIN_PACKAGE=com.team1.trading.domain
