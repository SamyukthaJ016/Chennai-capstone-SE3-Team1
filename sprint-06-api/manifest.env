# Sprint 6 - Trading REST API
#
# Declares the base package and sub-packages for layering checks and code organization.

BASE_PACKAGE=com.team1.trading.api
CONTROLLER_PACKAGE=com.team1.trading.api.controller
MAPPER_PACKAGE=com.team1.trading.api.mapper

# Coordinates of the Sprint 5 domain module, resolved from the local Maven repository.
# Must match what sprint-05-domain-engine/pom.xml installs (mvn install before mvn verify).
DOMAIN_GROUP_ID=com.team1.trading
DOMAIN_ARTIFACT_ID=domain-engine
DOMAIN_VERSION=1.0-SNAPSHOT
MAVEN_COORDINATES=com.team1.trading:domain-engine:1.0-SNAPSHOT
