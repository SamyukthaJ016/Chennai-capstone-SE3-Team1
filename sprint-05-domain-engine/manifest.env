# Sprint 5 - Trading Domain Engine
#
# Declares the base package this module's source lives under. Sprint 6
# absorbs this package into the Trade REST API under the same name, so it
# is chosen to say "domain" rather than "transport" and should not change
# after Sprint 6 depends on it.

BASE_PACKAGE=com.team1.trading.domain

# Coordinates installed into the local Maven repository by `mvn install`.
# Sprint 6 resolves this module by these coordinates.
MAVEN_GROUP_ID=com.team1.trading
MAVEN_ARTIFACT_ID=domain-engine
MAVEN_VERSION=1.0-SNAPSHOT
